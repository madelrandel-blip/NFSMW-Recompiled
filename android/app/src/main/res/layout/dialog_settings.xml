<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_settings_bg"
    android:padding="16dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙ GAME &amp; RUNTIME SETTINGS"
            android:textColor="@color/nfsmw_amber"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rom_button_bg"
            android:text="✕"
            android:textColor="@color/nfsmw_amber"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFB800"
        android:layout_marginBottom="10dp" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ========================================================= -->
            <!-- SECTION 1: VIDEO & PERFORMANCE                            -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 VIDEO &amp; PERFORMANCE"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <!-- Resolution -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output Resolution:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_resolution"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- Internal Resolution (Supersampling) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internal Engine Resolution (Supersampling):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_resolution_scale"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- V-Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vertical Sync (V-Sync)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_vsync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Stretch Screen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stretch Screen (Fill Entire Display)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_stretch_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Removes black bars by stretching the game to match the device aspect ratio."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SECTION 2: GRAPHICS ENGINE & VULKAN                       -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ GRAPHICS ENGINE &amp; VULKAN (ReXGlue)"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <!-- GPU Backend -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graphics Backend (GPU Emulator):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_gpu_plugin"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 'Plume' is the fastest native Vulkan rewrite. 'Xenos' uses original emulation."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- EDRAM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xenos EDRAM Emulation:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_edram_path"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 'rtv' (FBO) mode doubles the framerate and is highly recommended for phones."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Async Shader Compilation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Asynchronous Shader Compilation"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_async_shaders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Compiles pipelines in the background to reduce stuttering in-game."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Skip Incomplete Frames -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Skip Frames with Incomplete Shaders"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_async_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Avoids sudden FPS drops when new effects are compiled on the track."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Pipeline Threads -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vulkan Compilation Threads (Pipelines):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_pipeline_threads"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 2 Threads saves battery and reduces heat; 4 Threads compiles faster."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Texture Cache -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Texture Cache Memory Limit:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_texture_cache_limit"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 256MB or 384MB prevents forced closes due to low RAM on 4GB–6GB Android phones."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- GPU 3D to 2D -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Optimize 3D Textures to 2D (gpu_3d_to_2d)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_gpu_3d_to_2d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Saves graphics memory bandwidth on Adreno and Mali mobile GPUs."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Post-Processing / Bloom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Post-Processing Effects / Bloom (readback_resolve)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_readback_resolve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Disabling this greatly reduces GPU load and increases FPS on Android."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Anisotropic Filtering -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anisotropic Filtering (Road Sharpness):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_anisotropic"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- Anti-Aliasing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anti-Aliasing (FXAA):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_antialiasing"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- Native MSAA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Native MSAA 2x (Geometry Anti-Aliasing)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_native_msaa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Polygon smoothing. Keep disabled on mid-range phones."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SECTION 3: AUDIO & CONTROLS                               -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 AUDIO &amp; CONTROLS"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mute All Game Audio"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_audio_mute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Physical Keyboard &amp; Mouse Input"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_mnk_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 4: GAME & SYSTEM                                  -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏎️ GAME &amp; SYSTEM"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unlock Black Edition Content (Bonus Cars)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_black_edition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xbox Live Gold Account Privileges"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/sw_grant_privileges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player Gamertag:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_gamertag"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Runtime Log Level:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_log_level"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 'Error (Performance)' disables unnecessary logs, reducing I/O overhead on Android."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulation Speed: 100%"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/sb_game_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SECTION 5: VULKAN DRIVER (TURNIP / MESA)                  -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 VULKAN DRIVER (TURNIP / MESA)"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_turnip_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Driver: using system (default)"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Install Turnip/Mesa to enable Vulkan 1.3+, shaderInt64 and BDA — essential for Adreno GPUs whose stock driver does not expose these features."
                android:textColor="#808080"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btn_install_turnip"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rom_button_bg"
                    android:text="📦 INSTALL (ZIP)"
                    android:textColor="@color/nfsmw_amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_remove_turnip"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/rom_button_bg"
                    android:text="🗑 REMOVE"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download from: github.com/K11MCH1/AdrenoToolsDrivers — Adreno 6xx (650) or 7xx (730)"
                android:textColor="#606060"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_reset_defaults"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/rom_button_bg"
            android:text="🔄 ANDROID DEFAULTS"
            android:textColor="@color/nfsmw_amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/rom_button_bg"
            android:text="💾 SAVE &amp; APPLY"
            android:textColor="@color/nfsmw_amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

# =============================================================================
#  What is NEVER versioned
#
#  The first block is not a preference, it is the line that is not crossed. The
#  compiled executable carries the translated game code INSIDE it, so it
#  counts as the game, not as the project. Same for the C++ that comes out of
#  the generator. See the Legal section of the README.
# =============================================================================

# --- Game files --------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.pe
*.big
*.bun
*.viv

# --- Code generator output ---------------------------------------------------
# Derived from the XEX, so it is not distributed either.
generated/
app/generated/

# --- Build -------------------------------------------------------------------
out/
build/
app/build/
app/out/
CMakeUserPresets.json

# The game executable, whatever it is called. Kept apart from build/ because
# the launcher takes the pretty name and they are easy to confuse.
nfsmw.exe
NFS_Most_Wanted.exe

# The compiled launcher. The source is versioned; the binary is built.
Lanzador.exe

# --- The game cover art ------------------------------------------------------
# It is Electronic Arts artwork. The launcher starts perfectly fine without it:
# if the resource is missing, the side panel is drawn in black with the title.
# See docs/lanzador.md if you want to use your own.
tools/lanzador/portada.jpg
tools/lanzador/portada.png
tools/lanzador/icono.ico

# --- Logs and dumps ----------------------------------------------------------
logs/
*.log
*.rar
*.zip
*.7z

# Dumps generated by the tools that rebuild themselves.
docs/huecos.txt
docs/iso_listado.txt
docs/xex_info.txt
docs/sondeo_direcciones.txt
docs/rendimiento_resultados.txt
tools/huecos_functions.toml
docs/huecos_usa.txt
tools/huecos_functions_usa.toml

# --- Local configuration -----------------------------------------------------
# Launcher preferences and game settings: they belong to each machine.
lanzador.json
config/lanzador.json
nfsmw.toml.antes

# --- Editors -----------------------------------------------------------------
.vs/
.vscode/
.idea/
compile_commands.json
__pycache__/
*.pyc

# --- Android -----------------------------------------------------------------
# Machine-specific paths and native build artifacts. The prebuilt Android
# ReXGlue SDK in android/rexglue-sdk IS versioned (the APK build links it).
android/local.properties
android/.gradle/
android/app/.cxx/

# --- Patch backups -----------------------------------------------------------
# The current patches apply and revert by text and do not leave .original
# files, but some of the SDK ones still generate them.
*.original
